{
  "name": "ratchet-ui",
  "version": "0.4.2",
  "description": "The shared contract between agent-pipeline dashboards: wire types, runtime validators, a token contract with no palette in it, and the components both dashboards had each written for themselves.",
  "license": "Apache-2.0",
  "author": "Vasiliy Mikhailov <vasiliy.mikhailov@gmail.com>",
  "repository": { "type": "git", "url": "git+https://github.com/vasiliy-mikhailov/ratchet-ui.git" },
  "homepage": "https://github.com/vasiliy-mikhailov/ratchet-ui#readme",
  "keywords": ["agent", "dashboard", "contract", "design-tokens", "types", "react", "components"],
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "sideEffects": ["*.css"],
  "files": ["dist", "src/tokens.css", "tsconfig.base.json", "README.md", "ADOPTING.md", "LICENSE", "NOTICE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./wire": { "types": "./dist/wire.d.ts", "import": "./dist/wire.js" },
    "./check": { "types": "./dist/check.d.ts", "import": "./dist/check.js" },
    "./style": { "types": "./dist/style.d.ts", "import": "./dist/style.js" },
    "./time": { "types": "./dist/time.d.ts", "import": "./dist/time.js" },
    "./components": { "types": "./dist/components/index.d.ts", "import": "./dist/components/index.js" },
    "./tokens.css": "./src/tokens.css",
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
